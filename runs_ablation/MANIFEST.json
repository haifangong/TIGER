{
  "name": "runs_ablation",
  "description": "Paper-oriented ablation archive under similarity_threshold=0.3",
  "common_settings": {
    "similarity_threshold": 0.3,
    "structure_features": "s",
    "include_node_coords": false,
    "fusion": "attention",
    "fusion_attn_mode": "cross_qs",
    "seq_encoding": "integer",
    "global_feature_scaling": "zscore",
    "node_feature_scaling": "zscore",
    "seed": 1,
    "folds": 5,
    "lr": 0.001,
    "weight_decay": 0.0,
    "lr_scheduler": "cosine",
    "pair_interaction": "diff",
    "base_config": "code/configs/gsh_struct_s_base.json"
  },
  "ablations": {
    "01_modality_ablation": {
      "source_root": "outputs_code_struct_s_modality_grid",
      "launch_script": "scripts/launch_struct_s_modality_grid.sh",
      "run_script": "scripts/run_struct_s_modality_grid.py",
      "locked": {
        "pair_balance_num": 10000,
        "delta_bin_width": 1.0,
        "use_signed_sampling": false,
        "feature_modalities": "swept"
      },
      "sweep": {
        "feature_modalities": [
          "gsh",
          "gs",
          "sh",
          "gh",
          "g",
          "s",
          "h"
        ]
      },
      "n_points": 7
    },
    "02_pair_balance_bin1": {
      "source_root": "outputs_code_struct_s_binsize_grid",
      "launch_script": "scripts/launch_struct_s_binsize_grid.sh",
      "run_script": "scripts/run_struct_s_binsize_grid.py",
      "locked": {
        "feature_modalities": "gsh",
        "delta_bin_width": 1.0
      },
      "sweep": {
        "use_signed_sampling": [
          false,
          true
        ],
        "pair_balance_num": [
          1000,
          2000,
          4000,
          8000,
          10000,
          20000
        ]
      },
      "n_points": 12,
      "note": "When use_signed_sampling=false (unsigned), bin key = round(|\u0394|*100) and delta_bin_width is unused; pair_balance_num still caps per-bin samples. When signed=true, bin key = floor(\u0394 / delta_bin_width) with width=1.0."
    },
    "03_fusion_methods": {
      "source_roots": [
        "outputs_code_struct_s_sim_bin_qkv",
        "outputs_code_struct_s_concat_ablation",
        "outputs_code_struct_s_binsize_grid"
      ],
      "launch_scripts": [
        "scripts/launch_struct_s_sim_bin_qkv_grid.sh",
        "scripts/launch_struct_s_concat_ablation.sh",
        "scripts/launch_struct_s_binsize_grid.sh"
      ],
      "run_scripts": [
        "scripts/run_struct_s_sim_bin_qkv_grid.py",
        "scripts/run_struct_s_concat_ablation.py"
      ],
      "locked": {
        "similarity_threshold": 0.3,
        "feature_modalities": "gsh",
        "structure_features": "s",
        "include_node_coords": false,
        "use_signed_sampling": false,
        "delta_bin_width": 1.0
      },
      "panels": {
        "attn_mode_sweep_bal1000": [
          "attn_cross_qg_bal1000",
          "attn_cross_qh_bal1000",
          "attn_cross_qs_bal1000",
          "attn_self_gsh_bal1000",
          "attn_self_sgh_bal1000"
        ],
        "concat_vs_attention_bal10000": [
          "concat_gsh_bal10000",
          "attn_cross_qs_bal10000"
        ]
      },
      "n_points": 7,
      "note": "Two matched panels: (1) attention Q/KV modes & self-attn token orders at pair_balance_num=1000; (2) concat vs attention(cross_qs) at pair_balance_num=10000. Do not mix bals when comparing within a panel."
    },
    "04_similarity": {
      "source_roots": [
        "outputs_code_struct_s_binsize_grid",
        "outputs_code_struct_s_sim05_07_fusion"
      ],
      "locked": {
        "pair_balance_num": 10000,
        "feature_modalities": "gsh",
        "fusion_attn_mode": "cross_qs",
        "structure_features": "s",
        "include_node_coords": false,
        "use_signed_sampling": false,
        "delta_bin_width": 1.0
      },
      "sweep": {
        "similarity_threshold": [
          0.3,
          0.5,
          0.7
        ]
      },
      "n_points": 3,
      "note": "Training-pair similarity threshold ablation at fixed bal=10000 / cross_qs / gsh / unsigned."
    },
    "06_seq_encoding": {
      "source_root": "outputs_code_struct_s_seq_encoding_grid",
      "launch_script": "scripts/launch_struct_s_seq_encoding_grid.sh",
      "run_script": "scripts/run_struct_s_seq_encoding_grid.py",
      "train_wrapper": "code/scripts_train/run_ablation_06_seq_encoding.sh",
      "locked": {
        "feature_modalities": "gsh",
        "fusion": "attention",
        "fusion_attn_mode": "cross_qs",
        "similarity_threshold": 0.3,
        "delta_bin_width": 1.0,
        "pair_balance_num": 10000,
        "use_signed_sampling": false,
        "structure_features": "s",
        "include_node_coords": false,
        "seed": 1
      },
      "sweep": {
        "seq_encoding": [
          "integer",
          "embedding",
          "onehot"
        ]
      },
      "n_points": 3,
      "note": "Sequence-branch encoding ablation. integer = Linear(max_len) over AA codes; embedding = nn.Embedding; onehot = one-hot → Linear(21,d). Do not reuse outputs_ll37_seq_encoding_fix (older recipe)."
    }
  },
