{
  "name": "checkpoints/ablation",
  "description": "Released MIC ablation archive (slim fold*_best.pt). Per-run seed is taken from each config.json \u2014 do not assume seed=1 globally. Excluded from release: mod_s (invalid cross_qs sequence-only), sim0p5_bal10000.",
  "common_settings": {
    "structure_features": "s",
    "include_node_coords": false,
    "fusion": "attention",
    "fusion_attn_mode": "cross_qs",
    "global_feature_scaling": "zscore",
    "node_feature_scaling": "zscore",
    "folds": 5,
    "pair_interaction": "diff",
    "base_config": "code/configs/gsh_struct_s_base.json",
    "seed_policy": {
      "panels_01_04": 123,
      "panel_05_seed_stability": [
        1,
        2,
        3,
        4,
        5
      ],
      "panel_06_seq_encoding": 1,
      "note": "Recorded per experiment from config.json; README must match these values."
    },
    "excluded_points": [
      "01_modality_ablation/mod_s",
      "04_similarity/sim0p5_bal10000"
    ]
  },
  "ablations": {
    "01_modality_ablation": {
      "n_points": 6,
      "seed": 123,
      "sweep": {
        "feature_modalities": [
          "gsh",
          "gs",
          "sh",
          "gh",
          "g",
          "h"
        ]
      },
      "excluded": [
        "mod_s"
      ],
      "note": "mod_s (cross_qs sequence-only) excluded from release."
    },
    "02_pair_balance_bin1": {
      "n_points": 12,
      "seed": 123,
      "sweep": {
        "use_signed_sampling": [
          false,
          true
        ],
        "pair_balance_num": [
          1000,
          2000,
          4000,
          8000,
          10000,
          20000
        ]
      }
    },
