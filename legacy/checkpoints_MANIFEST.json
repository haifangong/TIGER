      "n_points": 7,
      "seed": 123
    },
    "04_similarity": {
      "n_points": 2,
      "seed": 123,
      "sweep": {
        "similarity_threshold": [
          0.3,
          0.7
        ]
      },
      "excluded": [
        "sim0p5_bal10000"
      ],
      "note": "Public release keeps sim 0.3 and 0.7 only."
    },
    "05_seed_stability": {
      "n_points": 10,
      "sweep": {
        "similarity_threshold": [
          0.3,
          0.7
        ],
        "seed": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    "06_seq_encoding": {
      "n_points": 3,
      "seed": 1,
      "sweep": {
        "seq_encoding": [
          "integer",
          "embedding",
          "onehot"
        ]
      }
    }
  },
